# Dependencies (the app itself has none; this guards against stray installs)
node_modules/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Local scratch
*.log

# Test screenshots and diagnostics
tests/.out/

# Credentials. A token sitting in the working tree is one `git add -A` away from
# a public repo, and GitHub revokes any token it finds in one - so the leak
# costs you the token as well. Keep tokens OUTSIDE the project directory; these
# rules are only a backstop.
*token*
*.token
*secret*
